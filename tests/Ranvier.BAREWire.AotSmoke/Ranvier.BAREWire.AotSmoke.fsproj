<Project Sdk="Microsoft.NET.Sdk">

    <!--
    A NativeAOT app over Ranvier.BAREWire, Ranvier.BAREWire.Query, Ranvier and Ranvier.Query.
    `dotnet publish -c Release -r <rid>` fails on any IL2xxx/IL3xxx warning: the assemblies are rooted, so ILC
    analyses their whole public surface, the vendored BAREWire code included. The published binary exits non-zero
    when a check fails.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <PublishAot>true</PublishAot>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Ranvier.BAREWire.Smoke/Checks.fs" Link="Checks.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Ranvier.BAREWire/Ranvier.BAREWire.fsproj" />
        <ProjectReference Include="../../src/Ranvier.BAREWire.Query/Ranvier.BAREWire.Query.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="Ranvier" />
        <TrimmerRootAssembly Include="Ranvier.Query" />
        <TrimmerRootAssembly Include="Ranvier.BAREWire" />
        <TrimmerRootAssembly Include="Ranvier.BAREWire.Query" />
    </ItemGroup>

</Project>

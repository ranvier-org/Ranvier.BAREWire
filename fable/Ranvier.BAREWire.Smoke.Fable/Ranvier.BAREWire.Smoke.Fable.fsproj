<Project Sdk="Microsoft.NET.Sdk">

    <!-- The checks of tests/Ranvier.BAREWire.Smoke, compiled with Fable (fickl) and run under Node. -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <IsExcludedFromRootBuild>true</IsExcludedFromRootBuild>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../../tests/Ranvier.BAREWire.Smoke/Checks.fs" Link="Checks.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Ranvier.BAREWire\Ranvier.BAREWire.fsproj" />
        <ProjectReference Include="..\..\src\Ranvier.BAREWire.Query\Ranvier.BAREWire.Query.fsproj" />
        <PackageReference Include="Fable.Core" Version="5.3.0" />
    </ItemGroup>

</Project>

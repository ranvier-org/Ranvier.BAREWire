<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Tailcalls>false</Tailcalls>
    <RootNamespace>Ranvier.BAREWire</RootNamespace>
    <AssemblyName>Ranvier.BAREWire</AssemblyName>
    <PackageId>Ranvier.BAREWire</PackageId>
    <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.BAREWire.Traced</PackageId>
    <Title>Ranvier.BAREWire</Title>
    <Description>BAREWire for Ranvier: BAREWire's encoder, decoder, schema and envelope framing on .NET (including netstandard2.1) and Fable, with typed BARE codecs that carry their schema, and asks, replies and events over BAREWire frames.</Description>
    <PackageTags>bare;barewire;binary;codec;wire;rpc;fsharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The assembly holds Ranvier's code (MIT) and BAREWire's (Apache-2.0); both licence texts are packed below. -->
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <Version>0.1.2</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <RanvierAotClean>true</RanvierAotClean>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarnOn>$(WarnOn);3390</WarnOn>
    <!-- BAREWire's own setting (BAREWire.fsproj): its float shim reads through native pointers. -->
    <NoWarn>$(NoWarn);FS0051</NoWarn>
  </PropertyGroup>
  <!-- BAREWire's sources, vendored and listed by scripts/vendor-barewire.ps1 (Vendor/BAREWire/VENDORED.md). -->
  <Import Project="Vendor/BAREWire/BAREWire.props" />
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="BareCodec.fs" />
    <Compile Include="Frames.fs" />
    <Compile Include="Session.fs" />
    <None Include="Vendor/BAREWire/LICENSE" Pack="true" PackagePath="licenses/BAREWire/" />
    <None Include="Vendor/BAREWire/PATENTS.md" Pack="true" PackagePath="licenses/BAREWire/" />
    <None Include="Vendor/BAREWire/Commercial.md" Pack="true" PackagePath="licenses/BAREWire/" />
    <None Include="Vendor/BAREWire/VENDORED.md" Pack="true" PackagePath="licenses/BAREWire/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="licenses/Ranvier.BAREWire/" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
    <AssemblyMetadata Include="RanvierTrace" Value="true" />
  </ItemGroup>
</Project>
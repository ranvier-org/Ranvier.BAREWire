<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Tailcalls>false</Tailcalls>
    <RootNamespace>Ranvier.BAREWire.Query</RootNamespace>
    <AssemblyName>Ranvier.BAREWire.Query</AssemblyName>
    <PackageId>Ranvier.BAREWire.Query</PackageId>
    <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.BAREWire.Query.Traced</PackageId>
    <Title>Ranvier.BAREWire.Query</Title>
    <Description>Ranvier.Query families and mutations whose remote calls are BAREWire asks, and BAREWire events delivered on the graph's thread.</Description>
    <PackageTags>bare;barewire;reactive;queries;cache;fsharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <RanvierAotClean>true</RanvierAotClean>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarnOn>$(WarnOn);3390</WarnOn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BareQuery.fs" />
    <None Include="../../LICENSE" Pack="true" PackagePath="licenses/Ranvier.BAREWire/" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
    <ProjectReference Include="../Ranvier.BAREWire/Ranvier.BAREWire.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRanvier)' == 'true'">
    <ProjectReference Include="$(RanvierRoot)/src/Ranvier/Ranvier.fsproj" />
    <ProjectReference Include="$(RanvierRoot)/src/Ranvier.Query/Ranvier.Query.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRanvier)' != 'true'">
    <PackageReference Include="Ranvier$(RanvierPackageSuffix)" Version="$(RanvierVersion)" />
    <PackageReference Include="Ranvier.Query$(RanvierPackageSuffix)" Version="$(RanvierQueryVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
    <AssemblyMetadata Include="RanvierTrace" Value="true" />
  </ItemGroup>
</Project>
